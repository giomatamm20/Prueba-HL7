# Server Linux: address of the Windows PC running the host/middleware.
HOST_MIDDLEWARE_HOST=192.168.1.101
HOST_MIDDLEWARE_PORT=2575
SEND_INTERVAL_SECONDS=10
ACK_TIMEOUT_SECONDS=8
RETRY_DELAY_SECONDS=5
ANALYZER_NAME=ABBOTT_CELL_DYN

# Analyzer Simulation Lab UI/API.
ANALYZER_SIMULATOR_PORT=8090

# Result destination for manual mode. Point this to Mirth or to the CodeIgniter/host MLLP listener.
RESULT_DESTINATION_HOST=host.docker.internal
RESULT_DESTINATION_PORT=2575

# Inbound HL7 order listener ports exposed by Analyzer Simulation Lab.
ABBOTT_RUBY_ORDER_PORT=5001
SYSMEX_XN_ORDER_PORT=5002
ARCHITECT_ORDER_PORT=5003
SYSMEX_UC_ASTM_ORDER_PORT=5004
GENERIC_HL7_ORDER_PORT=5010
GENERIC_ASTM_ORDER_PORT=5011
PACS_ORDER_PORT=5020
PACS_NOTIFICATION_HOST=host.docker.internal
PACS_NOTIFICATION_PORT=2575
# Credenciales locales del enlace PACS legado. Sustituir en cada ambiente.
PACS_LEGACY_KEY_CODE=RIS_LOCAL
PACS_LEGACY_KEY=local-pacs-integration-key-change-me
PACS_LEGACY_IV_HEX=00112233445566778899aabbccddeeff
PACS_LEGACY_USERNAME=ris_local
ORDER_LISTENERS_ENABLED=true
SIMULATOR_DB_PATH=/app/data/simulator.db

# Simulator ports: one initial Docker configuration, then add devices from the UI.
# For the hospital LAN, use its private address or the current 0.0.0.0 binding.
SIMULATOR_BIND_IP=0.0.0.0
# All simulator Compose files now include 5100-5119 by default.
# Compose selects its published pool; override only if publication also changes.
# SIMULATOR_ALLOWED_LISTEN_PORTS=5001-5004,5010-5011,5020,9500,5100-5119

# CodeIgniter host middleware.
HOST_CODEIGNITER_DATABASE_URL=postgresql://hl7host:hl7password@127.0.0.1:5432/hl7crm
HOST_CODEIGNITER_MLLP_HOST=0.0.0.0
HOST_CODEIGNITER_MLLP_PORT=2575
HOST_CODEIGNITER_WEB_HOST=0.0.0.0
HOST_CODEIGNITER_WEB_PORT=8088
RUBY_ORDER_HOST=127.0.0.1
RUBY_ORDER_PORT=5001
CI_ENVIRONMENT=development
