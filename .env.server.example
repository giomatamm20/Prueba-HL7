# Copy to .env.server on the destination server. Never overwrite an existing env.
COMPOSE_PROJECT_NAME=hl7-simulator
SIMULATOR_IMAGE=hl7-simulator:local

# Replace with the server's PRIVATE LAN/VPN IP to allow remote hospital access.
# The example starts locally only until you select the real server address.
SIMULATOR_BIND_IP=127.0.0.1
ANALYZER_SIMULATOR_PORT=8090

# Persistent host directory, relative to docker-compose.server.yml or absolute.
SIMULATOR_DATA_DIR=./data
# For migrating the separate AnaPath installation: anapath-simulator.db
SIMULATOR_DB_FILE=simulator.db

# Optional defaults for the built-in PACS profile.
# Configure the destination of each HL7 device in the application itself.
# host.docker.internal resolves to the Docker host, not to a different HIS PC.
RESULT_DESTINATION_HOST=host.docker.internal
RESULT_DESTINATION_PORT=2575
PACS_NOTIFICATION_HOST=host.docker.internal
PACS_NOTIFICATION_PORT=2575

SIMULATOR_READ_TIMEOUT=30
SIMULATOR_MAX_MESSAGE_BYTES=4194304
SIMULATOR_MAX_CONNECTIONS=64

# Optional, only for an existing PACS legacy secure-link integration.
PACS_LEGACY_KEY_CODE=
PACS_LEGACY_KEY=
PACS_LEGACY_IV_HEX=
PACS_LEGACY_USERNAME=
