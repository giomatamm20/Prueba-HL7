{
  "name": "hl7/host-codeigniter",
  "description": "HL7 host middleware migrated to PHP with CodeIgniter 4.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "codeigniter4/framework": "4.5.*",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "serve": "php spark serve --host 0.0.0.0 --port 8088",
    "mllp": "php spark hl7:mllp-listen"
  }
}
